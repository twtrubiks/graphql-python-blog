PROJECT_NAME="GraphQL Blog Platform"
VERSION="1.0.0"
DEBUG=True

# 資料庫配置
# DATABASE_URL 由 config.py 動態計算，無需在此設定
DB_HOST=localhost
DB_PORT=5432
DB_USER=blog_user
DB_PASSWORD=blog_password
DB_NAME=blog_db
TEST_DB_NAME=test_blog

SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080